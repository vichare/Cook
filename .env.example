APP_ENV=development
AUTH_MODE=dev
API_BIND=127.0.0.1:8080
DATABASE_URL=sqlite://data/cook.db
PUBLIC_ORIGIN=http://localhost:5173
OAUTH_STATE_DIGEST_KEY=replace-with-64-hex-characters
APP_SESSION_DIGEST_KEY=replace-with-independent-64-hex-characters
EMAIL_OTP_DIGEST_KEY=replace-with-another-independent-64-hex-characters
PASSKEY_CEREMONY_DIGEST_KEY=replace-with-another-independent-64-hex-characters
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Leave SMTP unset in development to use the capture sender. Production requires all six values.
# SMTP_HOST=replace-with-smtp-host
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=replace-with-smtp-username
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=Cook <replace-with-sender@example.com>
PASSKEY_RP_ID=localhost
PASSKEY_RP_ORIGIN=http://localhost:5173
PASSKEY_RP_NAME=Cook
