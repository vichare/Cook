{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cook.vichare.net/schemas/import-draft-v2.schema.json",
  "title": "Cook recipe import draft v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceUrl", "title", "ingredientModel", "ingredientGroups", "steps"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "sourceUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
    "sourceTitle": { "type": ["string", "null"], "maxLength": 200 },
    "sourceAuthor": { "type": ["string", "null"], "maxLength": 200 },
    "sourceLicense": { "type": ["string", "null"], "maxLength": 200 },
    "sourceAttribution": { "type": ["string", "null"], "maxLength": 1000 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000, "default": "" },
    "difficulty": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "estimatedCalories": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 },
    "ingredientModel": { "const": "groups-v1" },
    "ingredientGroups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/group" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "default": []
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "quantityNote", "sortOrder"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quantityNote": { "type": "string", "maxLength": 240, "default": "" },
        "canonicalIngredientId": { "type": ["string", "null"] },
        "sortOrder": {
          "type": "integer",
          "minimum": 0,
          "description": "Required explicit zero-based display order, unique within the containing group."
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "optional", "note", "sortOrder", "alternatives"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "optional": { "type": "boolean", "default": false },
        "note": { "type": "string", "maxLength": 240, "default": "" },
        "sortOrder": {
          "type": "integer",
          "minimum": 0,
          "description": "Required explicit zero-based display order, unique across ingredient groups."
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/alternative" }
        }
      }
    }
  }
}
