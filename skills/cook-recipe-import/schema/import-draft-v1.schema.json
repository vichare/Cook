{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cook.vichare.net/schemas/import-draft-v1.schema.json",
  "title": "Cook recipe import draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceUrl",
    "title",
    "ingredients",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "An HTTP or HTTPS source URL with a host."
    },
    "sourceTitle": {
      "type": "string",
      "maxLength": 200
    },
    "sourceAuthor": {
      "type": "string",
      "maxLength": 200
    },
    "sourceLicense": {
      "type": "string",
      "maxLength": 200,
      "description": "License text reported by the source or user; Cook does not independently verify it."
    },
    "sourceAttribution": {
      "type": "string",
      "maxLength": 1000
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "default": ""
    },
    "difficulty": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5,
      "description": "Optional whole-recipe difficulty aligned with the source's 1–5 scale."
    },
    "estimatedCalories": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100000,
      "description": "Optional estimated total kcal for the whole recipe, not per serving."
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/ingredient"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "description": "Combined step length must not exceed 20000 Unicode characters."
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "quantityNote": {
          "type": "string",
          "maxLength": 120,
          "default": ""
        }
      }
    }
  }
}
