# Copy to deploy/.env on the production host and fill every value. Never commit deploy/.env.

COOK_DOMAIN=cook.vichare.net
COOK_HOST_HTTP_ADDRESS=127.0.0.1:18080

# Google Web OAuth client. Register exactly:
# https://cook.vichare.net/api/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret

# Four independent random 32-byte keys encoded as 64 lowercase hex characters.
# Generate each with: openssl rand -hex 32
OAUTH_STATE_DIGEST_KEY=replace-with-64-hex-characters
APP_SESSION_DIGEST_KEY=replace-with-another-64-hex-characters
EMAIL_OTP_DIGEST_KEY=replace-with-another-64-hex-characters
PASSKEY_CEREMONY_DIGEST_KEY=replace-with-another-64-hex-characters

# TLS-protected SMTP transport for Email OTP. Never commit real values.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Cook <replace-with-sender@example.com>

# WebAuthn relying party settings are exact origin-bound security inputs.
PASSKEY_RP_ID=cook.vichare.net
PASSKEY_RP_ORIGIN=https://cook.vichare.net
PASSKEY_RP_NAME=Cook

RUST_LOG=cook_api=info,tower_http=info
COOK_BACKUP_KEEP=14

# Release deployments and ./upgrade.sh <image> set this value.
# COOK_IMAGE=ghcr.io/vichare/cook:vX.Y.Z
